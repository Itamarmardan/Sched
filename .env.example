# --- Auth (Phase 1) ---
# Shared password gating the whole app. Make it long and random.
APP_PASSWORD=
# Random 32+ byte secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# --- CalDAV / iCloud (Phase 2) ---
# Your Apple ID email.
ICLOUD_APPLE_ID=
# App-specific password generated at https://appleid.apple.com (NOT your real Apple ID password).
ICLOUD_APP_PASSWORD=

# --- Push notifications (Phase 4) ---
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: contact required by the push spec, e.g. mailto:you@example.com
VAPID_SUBJECT=

# --- Vercel Cron auth (Phase 4) ---
# Random secret; Vercel Cron sends it automatically as a Bearer token when configured in vercel.json.
CRON_SECRET=

# --- Upstash Redis (Phase 4, via Vercel Marketplace Redis integration) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
